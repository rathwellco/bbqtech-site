---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import StickyMobileCTA from "../components/StickyMobileCTA.astro";
import { siteConfig } from "../../site.config";
import { type Locale, t, getAltLocaleUrl } from "../i18n/utils";

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  canonicalUrl?: string;
  /** Override the full <title> tag (skips the titleTemplate wrap). */
  pageTitleOverride?: string;
  /** Explicit other-locale path for hreflang pairing (e.g. /en/packages/maintenance/). */
  altLocaleUrl?: string;
}

const { lang, title, description, canonicalUrl, pageTitleOverride, altLocaleUrl } = Astro.props;
const pageTitle = pageTitleOverride ?? t(siteConfig.seo.titleTemplate, lang).replace("%s", title);
const pageDescription = description || t(siteConfig.seo.defaultDescription, lang);
const pageOgImage = siteConfig.seo.ogImage;

const currentPath = Astro.url.pathname;
const altUrl = altLocaleUrl ?? getAltLocaleUrl(currentPath, lang);
const frUrl = lang === "fr" ? currentPath : altUrl;
const enUrl = lang === "en" ? currentPath : altUrl;
const canonical = canonicalUrl || `${siteConfig.url}${currentPath}`;

const localBusinessJsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": siteConfig.url,
  name: siteConfig.name,
  url: siteConfig.url,
  telephone: siteConfig.phoneRaw,
  email: siteConfig.email,
  priceRange: "$$",
  description: t(siteConfig.seo.defaultDescription, lang),
  address: {
    "@type": "PostalAddress",
    addressLocality: "Gatineau",
    addressRegion: siteConfig.region,
    addressCountry: siteConfig.country,
  },
  areaServed: [
    { "@type": "City", name: "Gatineau" },
    { "@type": "City", name: "Aylmer" },
    { "@type": "City", name: "Hull" },
    { "@type": "City", name: "Ottawa" },
  ],
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    opens: "08:00",
    closes: "20:00",
  },
};
---

<!DOCTYPE html>
<html lang={lang === "fr" ? "fr-CA" : "en-CA"}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonical} />

  <!-- hreflang -->
  <link rel="alternate" hreflang="fr-CA" href={`${siteConfig.url}${frUrl}`} />
  <link rel="alternate" hreflang="en-CA" href={`${siteConfig.url}${enUrl}`} />
  <link rel="alternate" hreflang="x-default" href={`${siteConfig.url}${frUrl}`} />

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === "fr" ? "fr_CA" : "en_CA"} />
  <meta property="og:image" content={`${siteConfig.url}${pageOgImage}`} />
  <meta property="og:site_name" content={siteConfig.name} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={siteConfig.fonts.googleFontsUrl} rel="stylesheet" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- LocalBusiness Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />

  <!-- GTM (via Cloudflare Tag Gateway — first-party path /analytics).
       GA4 + Google Ads conversion tags are configured INSIDE GTM, not here.
       Mirrors the ROG pattern (see clients/rog/06_build/site/src/layouts/Base.astro).
       Setup: Cloudflare → bbqtech.com zone → Zaraz / Tag Gateway → rewrite
       /analytics/* to https://www.googletagmanager.com/. -->
  {siteConfig.tracking.gtmId && (
    <script is:inline define:vars={{ gtmId: siteConfig.tracking.gtmId }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      '/analytics/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer',gtmId);
    </script>
  )}
</head>
<body class="text-dark leading-relaxed bg-white" style={`font-family: ${siteConfig.fonts.body}`}>
  {siteConfig.tracking.gtmId && (
    <noscript><iframe src={`/analytics/ns.html?id=${siteConfig.tracking.gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  )}
  <Nav lang={lang} />
  <main>
    <slot />
  </main>
  <Footer lang={lang} />
  <StickyMobileCTA lang={lang} />

  <!-- Attribution capture — first-touch per session.
       Stored in sessionStorage, injected into any [data-lead-form] submit. -->
  <script is:inline>
    (function () {
      const KEY = "bbqtech_attribution";
      if (sessionStorage.getItem(KEY)) return;
      const p = new URL(window.location.href).searchParams;
      sessionStorage.setItem(
        KEY,
        JSON.stringify({
          landing_page: window.location.href,
          referrer: document.referrer,
          utm_source: p.get("utm_source") || "",
          utm_medium: p.get("utm_medium") || "",
          utm_campaign: p.get("utm_campaign") || "",
          utm_term: p.get("utm_term") || "",
          utm_content: p.get("utm_content") || "",
          gclid: p.get("gclid") || "",
          gbraid: p.get("gbraid") || "",
          wbraid: p.get("wbraid") || "",
          fbclid: p.get("fbclid") || "",
          msclkid: p.get("msclkid") || "",
          session_start: new Date().toISOString(),
        })
      );
    })();
  </script>
</body>
</html>
