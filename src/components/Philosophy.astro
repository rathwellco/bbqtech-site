---
import { siteConfig } from "../../site.config";
import { type Locale, t } from "../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<section class="py-16 md:py-24 bg-[#0a0a0a] text-white relative overflow-hidden">
  <div class="absolute top-1/2 -translate-y-1/2 left-0 w-[400px] h-[400px] rounded-full bg-accent/10 blur-[100px]"></div>
  <div class="max-w-[1200px] mx-auto px-6 relative">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-accent mb-6">
        {t(siteConfig.philosophy.headline, lang)}
      </p>
      <blockquote class="text-2xl md:text-3xl font-bold leading-snug md:leading-tight mb-8 text-white">
        {t(siteConfig.philosophy.quote, lang)}
      </blockquote>
      <cite class="block text-sm md:text-base text-white/70 not-italic font-semibold">
        {t(siteConfig.philosophy.attribution, lang)}
      </cite>
    </div>
  </div>
</section>
