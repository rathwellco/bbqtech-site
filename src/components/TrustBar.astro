---
import { siteConfig } from "../../site.config";
import { type Locale, t } from "../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<section class="bg-accent text-white py-6">
  <div class="max-w-[1200px] mx-auto px-6 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-6">
    {siteConfig.pillars.map((p) => (
      <div class="flex items-center gap-2.5">
        <span class="text-xl shrink-0" aria-hidden="true">{p.icon}</span>
        <span class="text-sm font-bold leading-tight">{t(p.shortLabel, lang)}</span>
      </div>
    ))}
  </div>
</section>
