---
import { siteConfig } from "../../site.config";
import { type Locale, t } from "../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const b = siteConfig.brands;
const disclaimerLabel = lang === "fr" ? "Note légale" : "Legal note";
---

<section class="py-16 md:py-20 bg-light" id="marques">
  <div class="max-w-[1100px] mx-auto px-6">
    <div class="text-center mb-10 md:mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4">{t(b.title, lang)}</h2>
      <p class="text-lg text-grey max-w-3xl mx-auto leading-relaxed">{t(b.intro, lang)}</p>
    </div>

    <ul class="flex flex-wrap justify-center gap-2.5 max-w-[1000px] mx-auto mb-8">
      {b.list.map((brand) => (
        <li class="inline-block bg-white border border-grey-mid/50 rounded-full px-4 py-1.5 text-sm font-semibold text-dark">
          {brand}
        </li>
      ))}
    </ul>

    <div class="max-w-[900px] mx-auto bg-white border-l-4 border-accent rounded-r-lg p-5 md:p-6">
      <p class="text-xs font-bold uppercase tracking-wider text-accent mb-2">{disclaimerLabel}</p>
      <p class="text-sm text-dark leading-relaxed">{t(b.disclaimer, lang)}</p>
    </div>
  </div>
</section>
