---
import { siteConfig } from "../../site.config";
import { type Locale, t, localeHref } from "../i18n/utils";

interface Props {
  lang: Locale;
  title: string;
  subtitle?: string;
}

const { lang, title, subtitle } = Astro.props;
const ctaHref = localeHref(siteConfig.cta.primary.hrefPath, lang);
const includesLabel = lang === "fr" ? "Inclus" : "Includes";
const conditionsLabel = lang === "fr" ? "Conditions" : "Conditions";
---

<section class="py-16 md:py-20 bg-white" id="forfaits">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center mb-12 md:mb-14">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4">{title}</h2>
      {subtitle && <p class="text-lg text-grey max-w-2xl mx-auto">{subtitle}</p>}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6 max-w-[1100px] mx-auto items-stretch">
      {siteConfig.packages.map((pkg) => {
        const isRecommended = pkg.key === "signature";
        return (
          <div class:list={[
            "relative bg-white border rounded-2xl p-6 md:p-7 flex flex-col transition-all",
            isRecommended
              ? "border-accent shadow-xl md:scale-[1.02]"
              : "border-grey-mid/60 hover:border-accent/40 hover:shadow-md"
          ]}>
            {pkg.badge && (
              <span class:list={[
                "absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider whitespace-nowrap",
                isRecommended ? "bg-accent text-white" : "bg-black text-white"
              ]}>
                {t(pkg.badge, lang)}
              </span>
            )}

            <h3 class="text-xl font-extrabold text-dark mb-1">{t(pkg.name, lang)}</h3>
            <p class="text-2xl md:text-3xl font-extrabold text-accent mb-3">{t(pkg.priceLabel, lang)}</p>
            <p class="text-sm text-grey leading-relaxed mb-5">{t(pkg.tagline, lang)}</p>

            <div class="mb-5">
              <p class="text-xs font-bold uppercase tracking-wider text-grey mb-2">{includesLabel}</p>
              <ul class="space-y-1.5">
                {(pkg.includes[lang] ?? pkg.includes.fr).map((item) => (
                  <li class="flex items-start gap-2 text-sm text-dark leading-snug">
                    <span class="text-accent font-bold shrink-0 mt-0.5">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mb-6 pb-6 border-b border-grey-mid/40">
              <p class="text-xs font-bold uppercase tracking-wider text-grey mb-2">{conditionsLabel}</p>
              <p class="text-xs text-grey leading-relaxed">{t(pkg.conditions, lang)}</p>
            </div>

            <a
              href={ctaHref}
              class:list={[
                "block text-center px-5 py-3 rounded-lg text-sm font-bold no-underline transition-all mt-auto",
                isRecommended
                  ? "bg-accent text-white hover:bg-accent-hover"
                  : "bg-dark text-white hover:bg-accent"
              ]}
            >
              {t(pkg.ctaLabel, lang)}
            </a>
          </div>
        );
      })}
    </div>

    <p class="text-center text-sm text-grey mt-10 max-w-3xl mx-auto leading-relaxed">
      {t(siteConfig.packagesNote, lang)}
    </p>

    <div class="text-center mt-8">
      <a
        href={ctaHref}
        class="inline-block bg-black text-white px-7 py-4 rounded-lg font-bold hover:bg-accent transition-colors no-underline"
      >
        {t(siteConfig.cta.primary.label, lang)}
      </a>
    </div>
  </div>
</section>
