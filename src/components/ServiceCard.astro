---
interface Props {
  icon: string;
  title: string;
  price?: string;
  description: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { icon, title, price, description, ctaLabel, ctaHref } = Astro.props;
---

<div class="bg-white border border-grey-mid/50 rounded-xl p-7 hover:-translate-y-1 hover:shadow-xl hover:border-accent/40 transition-all">
  <div class="text-3xl mb-3" aria-hidden="true">{icon}</div>
  <h3 class="text-lg font-bold text-dark mb-1">{title}</h3>
  {price && <p class="text-accent font-extrabold text-xl mb-3">{price}</p>}
  <p class="text-sm text-grey leading-relaxed mb-4">{description}</p>
  {ctaLabel && ctaHref && (
    <a href={ctaHref} class="text-accent font-bold text-sm no-underline hover:underline">
      {ctaLabel} →
    </a>
  )}
</div>
