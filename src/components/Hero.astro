---
import { siteConfig } from "../../site.config";
import { type Locale, t, bookingHref, smsHref } from "../i18n/utils";

interface Props {
  lang: Locale;
  title: string;
  subtitle: string;
  short?: boolean;
  showCtas?: boolean;
  showHeroImage?: boolean;
}

const { lang, title, subtitle, short = false, showCtas = true, showHeroImage = true } = Astro.props;
const booking = bookingHref(siteConfig.bookingUrl, lang);
const sms = smsHref(siteConfig.phoneRaw, t(siteConfig.smsBody, lang));

const photoLabel = lang === "fr" ? "Envoyer une photo" : "Send a photo";
const callLabel = lang === "fr" ? "Appeler maintenant" : "Call now";
const operatorCaption = lang === "fr" ? "Nicholas · opérateur BBQTECH · Gatineau" : "Nicholas · BBQTECH operator · Gatineau";
const photoAlt = lang === "fr"
  ? "Nicholas, opérateur BBQTECH, en train de réparer un BBQ Masterbuilt chez un client à Gatineau"
  : "Nicholas, BBQTECH operator, repairing a Masterbuilt BBQ at a client's home in Gatineau";
---

<section class:list={[
  "relative bg-black text-white overflow-hidden",
  short ? "pt-12 pb-10 md:pt-16 md:pb-14" : "pt-16 pb-14 md:pt-20 md:pb-20"
]}>
  <div class="absolute inset-0 bg-gradient-to-br from-black via-[#0a0a0a] to-[#1a1a1a] -z-10"></div>
  <div class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full bg-accent/10 blur-[120px] -z-10"></div>

  <div class="max-w-[1200px] mx-auto px-6">
    <div class:list={[
      "grid items-center gap-10 md:gap-12",
      showHeroImage ? "lg:grid-cols-12" : ""
    ]}>
      <div class={showHeroImage ? "lg:col-span-7" : "max-w-3xl"}>
        <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold leading-[1.05] tracking-tight mb-6">
          {title}
        </h1>
        <p class="text-lg md:text-xl text-white/80 leading-relaxed max-w-2xl mb-8">
          {subtitle}
        </p>

        {showCtas && (
          <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-3">
            <a
              href={booking.href}
              target={booking.external ? "_blank" : undefined}
              rel={booking.external ? "noopener noreferrer" : undefined}
              class="inline-block text-center bg-accent text-white px-7 py-4 rounded-lg text-base font-bold hover:bg-accent-hover hover:-translate-y-0.5 transition-all no-underline shadow-lg shadow-accent/20"
            >
              {t(siteConfig.cta.primary.label, lang)}
            </a>
            <a
              href={sms}
              class="inline-block text-center text-white border-2 border-white/30 px-7 py-4 rounded-lg text-base font-bold hover:border-white hover:bg-white/5 transition-all no-underline"
            >
              <span aria-hidden="true">📸</span> {photoLabel}
            </a>
            <a
              href={`tel:${siteConfig.phoneRaw}`}
              class="inline-block text-center text-white border-2 border-white/30 px-7 py-4 rounded-lg text-base font-bold hover:border-white hover:bg-white/5 transition-all no-underline"
            >
              <span aria-hidden="true">📞</span> {callLabel}
            </a>
          </div>
        )}
      </div>

      {showHeroImage && (
        <div class="lg:col-span-5 relative">
          <div class="relative max-w-[420px] mx-auto lg:max-w-none">
            <!-- Accent glow behind the image -->
            <div class="absolute -inset-4 bg-accent/15 blur-2xl rounded-2xl -z-10"></div>
            <picture>
              <source media="(max-width: 768px)" srcset="/photos/hero/nicholas-action-mobile.webp" />
              <img
                src="/photos/hero/nicholas-action-large.webp"
                alt={photoAlt}
                width="1200"
                height="1600"
                loading="eager"
                fetchpriority="high"
                class="w-full h-auto rounded-2xl shadow-2xl border-2 border-white/10 aspect-[3/4] object-cover"
              />
            </picture>
            <div class="mt-4 text-center text-sm text-white/70 font-semibold tracking-wide">
              {operatorCaption}
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</section>
