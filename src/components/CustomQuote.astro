---
import { siteConfig } from "../../site.config";
import { type Locale, t, localeHref, smsHref } from "../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const cq = siteConfig.customQuote;
const cases = cq.cases[lang] ?? cq.cases.fr;
const contactHref = localeHref("/contact", lang);
const sms = smsHref(siteConfig.phoneRaw, t(siteConfig.smsBody, lang));
---

<section class="py-16 md:py-20 bg-white" id="soumission-perso">
  <div class="max-w-[1100px] mx-auto px-6">
    <div class="bg-light border border-grey-mid/60 rounded-2xl p-7 md:p-10">
      <div class="text-center mb-6 md:mb-8">
        <h2 class="text-2xl md:text-3xl font-extrabold mb-4">{t(cq.title, lang)}</h2>
        <p class="text-base md:text-lg text-grey max-w-2xl mx-auto">{t(cq.intro, lang)}</p>
      </div>

      <div class="max-w-[760px] mx-auto">
        <p class="text-sm font-bold uppercase tracking-wider text-grey mb-4">
          {t(cq.cueLine, lang)}
        </p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 mb-7">
          {cases.map((c) => (
            <li class="flex items-start gap-2 text-sm text-dark leading-snug">
              <span class="text-accent font-bold shrink-0 mt-0.5">·</span>
              <span>{c}</span>
            </li>
          ))}
        </ul>

        <p class="text-sm text-grey leading-relaxed mb-7 max-w-2xl">{t(cq.outro, lang)}</p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a
            href={contactHref}
            class="inline-block text-center bg-dark text-white px-6 py-3.5 rounded-lg text-sm font-bold hover:bg-accent transition-colors no-underline"
          >
            {t(cq.primaryCta, lang)}
          </a>
          <a
            href={sms}
            class="inline-block text-center text-dark hover:text-accent text-sm font-semibold py-3 sm:py-0 no-underline border-b border-dark/20 hover:border-accent/60 self-center"
          >
            📸 {t(siteConfig.cta.sms.label, lang)} · {siteConfig.phone}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
