---
import type { Locale } from "../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

interface Pair {
  beforeSrc: string;
  afterSrc: string;
  captionFr: string;
  captionEn: string;
  alt: string;
}

const pairs: Pair[] = [
  {
    beforeSrc: "/photos/before-after/broil-king-set-03-close-grates-avant.webp",
    afterSrc: "/photos/before-after/broil-king-set-03-close-grates-apres.webp",
    captionFr: "Grilles — gros plan",
    captionEn: "Grates — close-up",
    alt: "Broil King Signet 390 grates",
  },
  {
    beforeSrc: "/photos/before-after/broil-king-set-02-grilles-avant.webp",
    afterSrc: "/photos/before-after/broil-king-set-02-grilles-apres.webp",
    captionFr: "Grilles principales",
    captionEn: "Main grates",
    alt: "Broil King Signet 390 main grates",
  },
  {
    beforeSrc: "/photos/before-after/broil-king-set-04-cookbox-wide-avant.webp",
    afterSrc: "/photos/before-after/broil-king-set-04-cookbox-wide-apres.webp",
    captionFr: "Cuve et grilles — vue intérieure",
    captionEn: "Cookbox and grates — interior view",
    alt: "Broil King Signet 390 cookbox interior",
  },
  {
    beforeSrc: "/photos/before-after/broil-king-set-01-front-closed-avant.webp",
    afterSrc: "/photos/before-after/broil-king-set-01-front-closed-apres.webp",
    captionFr: "Façade extérieure",
    captionEn: "Exterior front",
    alt: "Broil King Signet 390 exterior front",
  },
];

const labels = {
  fr: {
    title: "Avant / Après — Broil King Signet 390",
    subtitle: "Un cas réel de Restauration Prestige vapeur avec remplacement de pièces.",
    contextLabel: "Contexte du service",
    contextItems: [
      { label: "BBQ", value: "Broil King Signet 390 — fortement encrassé, plusieurs saisons sans entretien" },
      { label: "Forfait", value: "Restauration Prestige vapeur — 395 $ + taxes" },
      { label: "Pièces remplacées", value: "Brûleurs, diffuseurs et collector box (service Diagnostic & Réparation séparé)" },
      { label: "Résultat", value: "Transformation complète — BBQ propre, plus performant, prolongation de sa durée de vie" },
    ],
    beforeLabel: "Avant",
    afterLabel: "Après",
    disclaimer: "Photos d'un service BBQTECH. Le nettoyage et le remplacement de pièces sont deux services séparés — combinés en une seule visite quand c'est possible.",
  },
  en: {
    title: "Before / After — Broil King Signet 390",
    subtitle: "A real Prestige Steam Restoration case with parts replacement.",
    contextLabel: "Service context",
    contextItems: [
      { label: "BBQ", value: "Broil King Signet 390 — heavily soiled, multiple seasons without maintenance" },
      { label: "Package", value: "Prestige Steam Restoration — $395 + tax" },
      { label: "Parts replaced", value: "Burners, heat diffusers and collector box (separate Diagnostic & Repair service)" },
      { label: "Result", value: "Complete transformation — clean BBQ, better performance, extended lifespan" },
    ],
    beforeLabel: "Before",
    afterLabel: "After",
    disclaimer: "Photos from a BBQTECH service. Cleaning and parts replacement are two separate services — combined in a single visit when possible.",
  },
}[lang];
---

<section class="py-16 md:py-20 bg-white">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center mb-10 md:mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-3">{labels.title}</h2>
      <p class="text-lg text-grey max-w-2xl mx-auto">{labels.subtitle}</p>
    </div>

    <!-- Context bar -->
    <div class="max-w-[1000px] mx-auto mb-10 md:mb-12 bg-light border border-grey-mid/40 rounded-xl p-5 md:p-6">
      <p class="text-xs font-bold uppercase tracking-wider text-grey mb-4">{labels.contextLabel}</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3">
        {labels.contextItems.map((item) => (
          <div class="flex flex-col">
            <span class="text-xs font-bold text-accent uppercase tracking-wider mb-0.5">{item.label}</span>
            <span class="text-sm text-dark leading-snug">{item.value}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- 4 before/after pairs -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
      {pairs.map((pair) => (
        <figure class="bg-light border border-grey-mid/40 rounded-xl overflow-hidden">
          <div class="grid grid-cols-2">
            <div class="relative">
              <img
                src={pair.beforeSrc}
                alt={`${labels.beforeLabel} — ${pair.alt}`}
                loading="lazy"
                width="600"
                height="450"
                class="w-full aspect-[4/3] object-cover block"
              />
              <span class="absolute top-2 left-2 bg-dark text-white text-xs font-bold uppercase tracking-wider px-2 py-1 rounded">
                {labels.beforeLabel}
              </span>
            </div>
            <div class="relative">
              <img
                src={pair.afterSrc}
                alt={`${labels.afterLabel} — ${pair.alt}`}
                loading="lazy"
                width="600"
                height="450"
                class="w-full aspect-[4/3] object-cover block"
              />
              <span class="absolute top-2 left-2 bg-accent text-white text-xs font-bold uppercase tracking-wider px-2 py-1 rounded">
                {labels.afterLabel}
              </span>
            </div>
          </div>
          <figcaption class="px-4 py-3 text-sm text-dark font-semibold border-t border-grey-mid/30 bg-white">
            {lang === "fr" ? pair.captionFr : pair.captionEn}
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="text-center text-xs text-grey mt-8 max-w-3xl mx-auto leading-relaxed italic">
      {labels.disclaimer}
    </p>
  </div>
</section>
