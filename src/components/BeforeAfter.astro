---
import type { Locale } from "../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

interface Pair {
  beforeSrc: string;
  afterSrc: string;
  captionFr: string;
  captionEn: string;
  alt: string;
}

interface CaseStudy {
  bbqFr: string;
  bbqEn: string;
  forfaitFr: string;
  forfaitEn: string;
  accentLabel: string;
  badgeStyle: "accent" | "dark";
  contextFr: { label: string; value: string }[];
  contextEn: { label: string; value: string }[];
  pairs: Pair[];
  comingSoonFr?: { headline: string; body: string };
  comingSoonEn?: { headline: string; body: string };
}

const napoleonFreestyle: CaseStudy = {
  bbqFr: "Napoleon FreeStyle",
  bbqEn: "Napoleon FreeStyle",
  forfaitFr: "Nettoyage Signature — à partir de 299 $",
  forfaitEn: "Signature Cleaning — from $299",
  accentLabel: "Nettoyage Signature",
  badgeStyle: "accent",
  contextFr: [
    { label: "BBQ", value: "Napoleon FreeStyle — entretien annuel après une saison d'utilisation" },
    { label: "Forfait", value: "Nettoyage Signature — à partir de 299 $ + taxes" },
    { label: "Travail effectué", value: "Dégraissage en 2 applications, grilles et composantes détaillées, intérieur du cabinet" },
    { label: "Résultat", value: "BBQ propre et prêt pour la saison — fonctionnement plus agréable lorsque l'état des composantes le permet" },
  ],
  contextEn: [
    { label: "BBQ", value: "Napoleon FreeStyle — annual maintenance after a season of use" },
    { label: "Package", value: "Signature Cleaning — from $299 + tax" },
    { label: "Work done", value: "Two-pass degreasing, detailed grates and components, cabinet interior" },
    { label: "Result", value: "Clean BBQ ready for the season — more pleasant to use when component condition allows" },
  ],
  pairs: [
    {
      beforeSrc: "/photos/before-after/napoleon-freestyle-set-03-grates-close-avant.webp",
      afterSrc: "/photos/before-after/napoleon-freestyle-after-03-grilles-closeup.webp",
      captionFr: "Grilles — gros plan",
      captionEn: "Grates — close-up",
      alt: "Napoleon FreeStyle grates close-up",
    },
    {
      beforeSrc: "/photos/before-after/napoleon-freestyle-set-02-grill-open-avant.webp",
      afterSrc: "/photos/before-after/napoleon-freestyle-after-02-grilles-wide.webp",
      captionFr: "Couvercle ouvert — grilles et cuve",
      captionEn: "Hood open — grates and cookbox",
      alt: "Napoleon FreeStyle hood open",
    },
    {
      beforeSrc: "/photos/before-after/napoleon-freestyle-set-04-cabinet-base-avant.webp",
      afterSrc: "/photos/before-after/napoleon-freestyle-after-04-base-cabinet.webp",
      captionFr: "Intérieur du cabinet",
      captionEn: "Cabinet interior",
      alt: "Napoleon FreeStyle cabinet interior",
    },
    {
      beforeSrc: "/photos/before-after/napoleon-freestyle-set-01-front-closed-avant.webp",
      afterSrc: "/photos/before-after/napoleon-freestyle-after-01-front-closed.webp",
      captionFr: "Façade extérieure",
      captionEn: "Exterior front",
      alt: "Napoleon FreeStyle exterior front",
    },
  ],
};

const broilKing: CaseStudy = {
  bbqFr: "Broil King Signet 390",
  bbqEn: "Broil King Signet 390",
  forfaitFr: "Restauration Prestige — à partir de 399 $ + pièces",
  forfaitEn: "Prestige Steam Restoration — from $399 + parts",
  accentLabel: "Restauration Prestige",
  badgeStyle: "dark",
  contextFr: [
    { label: "BBQ", value: "Broil King Signet 390 — fortement encrassé, plusieurs saisons sans entretien" },
    { label: "Forfait", value: "Restauration Prestige — à partir de 399 $ + taxes" },
    { label: "Pièces remplacées", value: "Brûleurs, diffuseurs et collector box (service Diagnostic & Réparation séparé)" },
    { label: "Résultat", value: "Remise en état visuelle importante — BBQ propre, fonctionnement plus agréable, aide à mieux entretenir l'équipement et à identifier les pièces à surveiller" },
  ],
  contextEn: [
    { label: "BBQ", value: "Broil King Signet 390 — heavily soiled, multiple seasons without maintenance" },
    { label: "Package", value: "Prestige Steam Restoration — from $399 + tax" },
    { label: "Parts replaced", value: "Burners, heat diffusers and collector box (separate Diagnostic & Repair service)" },
    { label: "Result", value: "Significant visual restoration — clean BBQ, more pleasant operation, helps maintain the equipment and identify parts to watch" },
  ],
  pairs: [
    {
      beforeSrc: "/photos/before-after/broil-king-set-03-close-grates-avant.webp",
      afterSrc: "/photos/before-after/broil-king-set-03-close-grates-apres.webp",
      captionFr: "Grilles — gros plan",
      captionEn: "Grates — close-up",
      alt: "Broil King Signet 390 grates",
    },
    {
      beforeSrc: "/photos/before-after/broil-king-set-02-grilles-avant.webp",
      afterSrc: "/photos/before-after/broil-king-set-02-grilles-apres.webp",
      captionFr: "Grilles principales",
      captionEn: "Main grates",
      alt: "Broil King Signet 390 main grates",
    },
    {
      beforeSrc: "/photos/before-after/broil-king-set-04-cookbox-wide-avant.webp",
      afterSrc: "/photos/before-after/broil-king-set-04-cookbox-wide-apres.webp",
      captionFr: "Cuve et grilles — vue intérieure",
      captionEn: "Cookbox and grates — interior view",
      alt: "Broil King Signet 390 cookbox interior",
    },
    {
      beforeSrc: "/photos/before-after/broil-king-set-01-front-closed-avant.webp",
      afterSrc: "/photos/before-after/broil-king-set-01-front-closed-apres.webp",
      captionFr: "Façade extérieure",
      captionEn: "Exterior front",
      alt: "Broil King Signet 390 exterior front",
    },
  ],
};

const caseStudies = [napoleonFreestyle, broilKing];

const labels = {
  fr: {
    title: "Avant / Après — services BBQTECH",
    subtitle: "Deux cas concrets : un nettoyage annuel sur un BBQ utilisé en saison, et une remise en état complète avec remplacement de pièces sur un BBQ négligé depuis plusieurs années.",
    contextLabel: "Contexte du service",
    beforeLabel: "Avant",
    afterLabel: "Après",
    disclaimer: "Photos de services BBQTECH. Le nettoyage et le remplacement de pièces sont deux services séparés — combinés en une seule visite quand c'est possible.",
  },
  en: {
    title: "Before / After — BBQTECH services",
    subtitle: "Two concrete cases: an annual cleaning on a BBQ used in season, and a full restoration with parts replacement on a BBQ neglected for several years.",
    contextLabel: "Service context",
    beforeLabel: "Before",
    afterLabel: "After",
    disclaimer: "Photos from BBQTECH services. Cleaning and parts replacement are two separate services — combined in a single visit when possible.",
  },
}[lang];
---

<section class="py-16 md:py-20 bg-white">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center mb-12 md:mb-14">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-3">{labels.title}</h2>
      <p class="text-lg text-grey max-w-3xl mx-auto">{labels.subtitle}</p>
    </div>

    {caseStudies.map((cs, csIdx) => {
      const bbq = lang === "fr" ? cs.bbqFr : cs.bbqEn;
      const forfait = lang === "fr" ? cs.forfaitFr : cs.forfaitEn;
      const contextItems = lang === "fr" ? cs.contextFr : cs.contextEn;
      return (
        <div class={csIdx > 0 ? "mt-16 md:mt-20" : ""}>
          <!-- Case study header -->
          <div class="mb-6 md:mb-8 max-w-[1000px] mx-auto">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2 mb-2">
              <span class:list={[
                "inline-block text-white text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded",
                cs.badgeStyle === "accent" ? "bg-accent" : "bg-dark"
              ]}>
                {cs.accentLabel}
              </span>
              <h3 class="text-2xl md:text-3xl font-extrabold text-dark">{bbq}</h3>
            </div>
            <p class="text-base md:text-lg font-bold text-accent">{forfait}</p>
          </div>

          <!-- Context bar -->
          <div class="max-w-[1000px] mx-auto mb-6 md:mb-8 bg-light border border-grey-mid/40 rounded-xl p-5 md:p-6">
            <p class="text-xs font-bold uppercase tracking-wider text-grey mb-4">{labels.contextLabel}</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3">
              {contextItems.map((item) => (
                <div class="flex flex-col">
                  <span class="text-xs font-bold text-accent uppercase tracking-wider mb-0.5">{item.label}</span>
                  <span class="text-sm text-dark leading-snug">{item.value}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- before/after pairs -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
            {cs.pairs.map((pair) => (
              <figure class="bg-light border border-grey-mid/40 rounded-xl overflow-hidden">
                <div class="grid grid-cols-2">
                  <div class="relative">
                    <img
                      src={pair.beforeSrc}
                      alt={`${labels.beforeLabel} — ${pair.alt}`}
                      loading="lazy"
                      width="600"
                      height="450"
                      class="w-full aspect-[4/3] object-cover block"
                    />
                    <span class="absolute top-2 left-2 bg-dark text-white text-xs font-bold uppercase tracking-wider px-2 py-1 rounded">
                      {labels.beforeLabel}
                    </span>
                  </div>
                  <div class="relative">
                    <img
                      src={pair.afterSrc}
                      alt={`${labels.afterLabel} — ${pair.alt}`}
                      loading="lazy"
                      width="600"
                      height="450"
                      class="w-full aspect-[4/3] object-cover block"
                    />
                    <span class="absolute top-2 left-2 bg-accent text-white text-xs font-bold uppercase tracking-wider px-2 py-1 rounded">
                      {labels.afterLabel}
                    </span>
                  </div>
                </div>
                <figcaption class="px-4 py-3 text-sm text-dark font-semibold border-t border-grey-mid/30 bg-white">
                  {lang === "fr" ? pair.captionFr : pair.captionEn}
                </figcaption>
              </figure>
            ))}
          </div>

          {(lang === "fr" ? cs.comingSoonFr : cs.comingSoonEn) && (() => {
            const cs2 = lang === "fr" ? cs.comingSoonFr! : cs.comingSoonEn!;
            return (
              <div class="mt-6 md:mt-8 max-w-[1000px] mx-auto bg-dark text-white rounded-xl p-6 md:p-8 border-l-4 border-accent">
                <div class="flex items-start gap-4">
                  <div class="shrink-0 w-12 h-12 rounded-full bg-accent/20 flex items-center justify-center text-2xl">
                    <span aria-hidden="true">🔧</span>
                  </div>
                  <div class="flex-1">
                    <h4 class="text-lg md:text-xl font-extrabold mb-2 text-accent">{cs2.headline}</h4>
                    <p class="text-white/85 leading-relaxed">{cs2.body}</p>
                  </div>
                </div>
              </div>
            );
          })()}
        </div>
      );
    })}

    <p class="text-center text-xs text-grey mt-12 max-w-3xl mx-auto leading-relaxed italic">
      {labels.disclaimer}
    </p>
  </div>
</section>
