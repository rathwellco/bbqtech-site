---
import { siteConfig } from "../../site.config";
import { type Locale, t, bookingHref } from "../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
// Diagnostic section CTA → /diagnostic (the repair-specific form), NOT the
// generic /reservation fallback used by other "Réserver" CTAs.
const booking = bookingHref(siteConfig.bookingUrl, lang, "/diagnostic");
const r = siteConfig.repair;
const prepLabel = lang === "fr" ? "Préparation pour accélérer le diagnostic" : "Preparation to speed up the diagnostic";
const gasLimitLabel = lang === "fr" ? "Limites — installations de gaz" : "Limits — gas installations";
const inspectionLabel = lang === "fr" ? "Inspection visuelle vs diagnostic" : "Visual inspection vs diagnostic";
---

<section class="py-16 md:py-20 bg-light" id="reparation">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center mb-12 md:mb-14">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4">{t(r.title, lang)}</h2>
      <p class="text-lg text-grey max-w-2xl mx-auto">{t(r.subtitle, lang)}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[380px_1fr] gap-6 md:gap-10 max-w-[1100px] mx-auto items-start">
      <!-- Price card -->
      <div class="bg-black text-white rounded-2xl p-7 md:p-8 shadow-xl">
        <p class="text-sm font-bold uppercase tracking-wider text-accent mb-2">
          {t(r.diagnosticHeading, lang)}
        </p>
        <p class="text-4xl md:text-5xl font-extrabold mb-4 leading-none">
          {t(r.diagnosticPriceLabel, lang)}
        </p>
        <p class="text-sm text-white/85 leading-relaxed mb-6">
          {t(r.mainBody, lang)}
        </p>
        <div class="space-y-3">
          <a
            href={booking.href}
            target={booking.external ? "_blank" : undefined}
            rel={booking.external ? "noopener noreferrer" : undefined}
            class="block text-center bg-accent text-white px-5 py-3.5 rounded-lg text-sm font-bold no-underline hover:bg-accent-hover transition-colors"
          >
            {t(r.ctaLabel, lang)}
          </a>
          <a
            href={`tel:${siteConfig.phoneRaw}`}
            class="block text-center text-white border-2 border-white/30 px-5 py-3 rounded-lg text-sm font-bold no-underline hover:border-white hover:bg-white/5 transition-colors"
          >
            📞 {siteConfig.phone}
          </a>
        </div>
      </div>

      <!-- Process steps + tiers + notes -->
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-grey mb-4">
          {t(r.processHeading, lang)}
        </p>
        <div class="space-y-4" role="list">
          {r.steps.map((step) => (
            <div role="listitem" class="flex items-start gap-4 bg-white rounded-xl p-4 md:p-5 border border-grey-mid/40">
              <span class="w-9 h-9 rounded-full bg-accent text-white text-sm font-extrabold flex items-center justify-center shrink-0">
                {step.number}
              </span>
              <div>
                <h3 class="text-base font-bold text-dark mb-1">{t(step.title, lang)}</h3>
                <p class="text-sm text-grey leading-relaxed">{t(step.desc, lang)}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Other tiers (add-on diagnostic + installation) -->
        <p class="text-xs font-bold uppercase tracking-wider text-grey mt-8 mb-4">
          {t(r.tiersHeading, lang)}
        </p>
        <div class="space-y-4">
          {r.tiers.map((tier) => (
            <div class="bg-white rounded-xl p-5 md:p-6 border border-grey-mid/40">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
                <h3 class="text-base font-extrabold text-dark">{t(tier.name, lang)}</h3>
                <span class="text-accent font-extrabold whitespace-nowrap">{t(tier.priceLabel, lang)}</span>
              </div>
              <p class="text-sm text-grey leading-relaxed">{t(tier.body, lang)}</p>
            </div>
          ))}
        </div>

        <div class="mt-6 p-4 bg-white border border-grey-mid/50 rounded-lg">
          <p class="text-xs font-bold uppercase tracking-wider text-grey mb-2">
            {inspectionLabel}
          </p>
          <p class="text-sm text-grey leading-relaxed">{t(r.inspectionDistinction, lang)}</p>
        </div>

        <div class="mt-4 p-4 bg-white border-l-4 border-accent border border-grey-mid/50 rounded-lg">
          <p class="text-xs font-bold uppercase tracking-wider text-accent mb-2">
            {gasLimitLabel}
          </p>
          <p class="text-sm text-dark leading-relaxed">{t(r.gasLimit, lang)}</p>
        </div>

        <div class="mt-4 p-4 bg-white border border-grey-mid/50 rounded-lg">
          <p class="text-xs font-bold uppercase tracking-wider text-grey mb-2">
            {prepLabel}
          </p>
          <p class="text-sm text-grey leading-relaxed">{t(r.diagnosticPrep, lang)}</p>
        </div>
      </div>
    </div>
  </div>
</section>
