---
import { siteConfig } from "../../site.config";
import { type Locale } from "../i18n/utils";

type Variant = "cleaning" | "repair" | "assembly" | "general";

interface Props {
  lang: Locale;
  variant?: Variant;
  defaultForfait?: string;
  source?: string;
}

const {
  lang,
  variant = "general",
  defaultForfait,
  source,
} = Astro.props;

const isFr = lang === "fr";

// Auto-derived source — drives lead.ts subject differentiation + GTM segmentation.
const autoSource =
  variant === "cleaning" ? "Website - Reservation Nettoyage"
  : variant === "repair" ? "Website - Reservation Reparation"
  : variant === "assembly" ? "Website - Reservation Assemblage"
  : "Website - Contact";
const resolvedSource = source || autoSource;

const labels = isFr
  ? {
      name: "Nom complet",
      phone: "Téléphone",
      email: "Courriel",
      contactGroupHint: "Téléphone ou courriel — au moins un",
      address: "Adresse ou secteur",
      addressPlaceholder: "123 rue Principale, Gatineau QC J8X 1A1",
      cityArea: "Ville ou secteur",
      cityAreaPlaceholder: "Gatineau, Aylmer, Ottawa, etc.",
      bbqBrand: "Marque et modèle du BBQ",
      bbqBrandLabel: "Marque / modèle si connu",
      bbqBrandPlaceholder: "Weber Genesis II, Napoleon Prestige 500, etc.",
      symptom: "Problème observé",
      symptomPlaceholder: "Ne s'allume pas, flamme faible, rouille des brûleurs, chaleur inégale…",
      cleaningMessage: "Message ou état du BBQ",
      cleaningMessagePlaceholder: "État général, accès, particularités, préférences d'horaire…",
      assemblyDate: "Date souhaitée",
      assemblyMessage: "Message",
      assemblyMessagePlaceholder: "Type d'équipement, marque, accès, préférences…",
      message: "Message",
      messagePlaceholder: "Détails de votre demande…",
      optional: "facultatif",
      submitCleaning: "Réserver mon nettoyage",
      submitRepair: "Demander un diagnostic",
      submitAssembly: "Demander un assemblage",
      submitGeneral: "Envoyer ma demande",
      privacy: "Réponse confirmée sous 24 h. Aucun pourriel.",
      sentSuccess: "Merci, votre demande a été reçue. On vous répond sous 24 h.",
      sentError: "Une erreur est survenue. Appelez 819-561-0762 ou réessayez.",
      requireOneError: "Téléphone ou courriel requis (au moins un).",
      repairBanner: "Frais d'évaluation à domicile : 99 $ + taxes. Le diagnostic identifie la cause et les réparations recommandées. Pièces et main-d'œuvre facturées séparément si vous approuvez la réparation.",
      forfaitLabel: "Forfait souhaité",
      recommendedBadge: "RECOMMANDÉ",
      smsPhotoHint: "📱 Pour accélérer la confirmation, vous pouvez aussi envoyer une photo de votre BBQ par SMS au 819-561-0762.",
    }
  : {
      name: "Full name",
      phone: "Phone",
      email: "Email",
      contactGroupHint: "Phone or email — at least one",
      address: "Address or area",
      addressPlaceholder: "123 Main St, Gatineau QC J8X 1A1",
      cityArea: "City or area",
      cityAreaPlaceholder: "Gatineau, Aylmer, Ottawa, etc.",
      bbqBrand: "BBQ brand and model",
      bbqBrandLabel: "Brand / model if known",
      bbqBrandPlaceholder: "Weber Genesis II, Napoleon Prestige 500, etc.",
      symptom: "Observed problem",
      symptomPlaceholder: "Won't ignite, weak flame, rusty burners, uneven heat…",
      cleaningMessage: "Message or BBQ condition",
      cleaningMessagePlaceholder: "Overall condition, access, specifics, schedule preferences…",
      assemblyDate: "Preferred date",
      assemblyMessage: "Message",
      assemblyMessagePlaceholder: "Equipment type, brand, access, preferences…",
      message: "Message",
      messagePlaceholder: "Details about your request…",
      optional: "optional",
      submitCleaning: "Book my cleaning",
      submitRepair: "Request a diagnostic",
      submitAssembly: "Request an assembly",
      submitGeneral: "Send my request",
      privacy: "Confirmed reply within 24 h. No spam, ever.",
      sentSuccess: "Thanks, your request was received. We'll reply within 24 h.",
      sentError: "Something went wrong. Call 819-561-0762 or try again.",
      requireOneError: "Phone or email required (at least one).",
      repairBanner: "On-site assessment fee: $99 + taxes. The diagnostic identifies the cause and the recommended repairs. Parts and labour billed separately if you approve the repair.",
      forfaitLabel: "Preferred package",
      recommendedBadge: "RECOMMENDED",
      smsPhotoHint: "📱 To speed up confirmation, you can also text a photo of your BBQ to 819-561-0762.",
    };

const submitLabel =
  variant === "cleaning" ? labels.submitCleaning
  : variant === "repair" ? labels.submitRepair
  : variant === "assembly" ? labels.submitAssembly
  : labels.submitGeneral;

// Cleaning packages — only shown on the cleaning variant. 3 options, sub-Hick's-Law
// threshold, no grouping needed. Recommended badge on Nettoyage.
type ForfaitOption = { v: string; title: string; price: string; desc: string; recommended?: boolean };

const cleaningPackages: ForfaitOption[] = isFr
  ? [
      { v: "Entretien", title: "Entretien", price: "199 $ + tx", desc: "Inspection + entretien saisonnier léger" },
      { v: "Nettoyage", title: "Nettoyage", price: "299 $ + tx", desc: "Dégraissage approfondi en 2 applications", recommended: true },
      { v: "Restauration", title: "Restauration", price: "à partir de 399 $ + tx", desc: "Vapeur + multiples passes + finition" },
    ]
  : [
      { v: "Maintenance", title: "Maintenance", price: "$199 + tx", desc: "Inspection + light seasonal upkeep" },
      { v: "Cleaning", title: "Cleaning", price: "$299 + tx", desc: "Deep degreasing in 2 passes", recommended: true },
      { v: "Restoration", title: "Restoration", price: "from $399 + tx", desc: "Steam + multiple passes + finish" },
    ];

// Pre-select a forfait from URL slug (e.g. /reservation-nettoyage?forfait=signature).
const forfaitSlugMap: Record<string, string> = {
  entretien: isFr ? "Entretien" : "Maintenance",
  essentiel: isFr ? "Entretien" : "Maintenance",
  essential: isFr ? "Entretien" : "Maintenance",
  nettoyage: isFr ? "Nettoyage" : "Cleaning",
  signature: isFr ? "Nettoyage" : "Cleaning",
  restauration: isFr ? "Restauration" : "Restoration",
  prestige: isFr ? "Restauration" : "Restoration",
  maintenance: isFr ? "Entretien" : "Maintenance",
  cleaning: isFr ? "Nettoyage" : "Cleaning",
  restoration: isFr ? "Restauration" : "Restoration",
};
const resolvedDefaultForfait = defaultForfait
  ? (forfaitSlugMap[defaultForfait.toLowerCase()] ?? defaultForfait)
  : undefined;
---

<div class="max-w-[640px] mx-auto">
  <div id="form-status-success" class="hidden mb-6 p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm">
    {labels.sentSuccess}
  </div>
  <div id="form-status-error" class="hidden mb-6 p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm">
    {labels.sentError}
  </div>

  {/* Repair variant — always-visible banner with the $99 assessment fee info */}
  {variant === "repair" && (
    <div class="mb-6 p-4 bg-accent/5 border-l-4 border-accent rounded-r-lg text-sm text-dark leading-relaxed">
      <strong class="text-accent">99 $ + tx</strong> · {labels.repairBanner}
    </div>
  )}

  <form
    method="POST"
    action="/api/lead"
    accept-charset="UTF-8"
    class="bg-white rounded-xl p-6 md:p-8 shadow-sm border border-grey-mid/40"
    data-lead-form
    data-error-require-one={labels.requireOneError}
    data-error-default={labels.sentError}
    id="bbqtech-lead-form"
  >
    <input type="hidden" name="source" value={resolvedSource} />
    <input type="hidden" name="language" value={lang} />
    <input type="hidden" name="variant" value={variant} />

    {/* Cleaning variant — 3 radio cards with Recommandé badge on Nettoyage */}
    {variant === "cleaning" && (
      <fieldset class="mb-6 border-0 p-0">
        <legend class="block text-sm font-bold text-dark mb-3">{labels.forfaitLabel}</legend>
        <div class="grid grid-cols-1 gap-2">
          {cleaningPackages.map((o) => (
            <label class="relative flex items-start gap-3 p-3 border border-grey-mid rounded-lg cursor-pointer hover:border-accent hover:bg-accent/5 transition-colors has-[:checked]:border-accent has-[:checked]:bg-accent/5 has-[:checked]:shadow-sm">
              <input
                type="radio"
                name="forfait"
                value={o.v}
                checked={resolvedDefaultForfait === o.v}
                class="mt-0.5 accent-accent w-4 h-4 flex-shrink-0"
              />
              <span class="flex-1 min-w-0">
                <span class="flex items-baseline justify-between gap-2 flex-wrap">
                  <span class="flex items-center gap-2 flex-wrap">
                    <span class="font-bold text-dark text-sm">{o.title}</span>
                    {o.recommended && (
                      <span class="bg-accent text-white text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded leading-none">{labels.recommendedBadge}</span>
                    )}
                  </span>
                  <span class="text-xs text-accent font-bold">{o.price}</span>
                </span>
                <span class="block text-xs text-grey mt-0.5">{o.desc}</span>
              </span>
            </label>
          ))}
        </div>
      </fieldset>
    )}

    {/* Repair variant — hidden forfait=Diagnostic so lead.ts + GTM tracking know this is a repair */}
    {variant === "repair" && (
      <input type="hidden" name="forfait" value="Diagnostic" />
    )}

    {/* Assembly variant — hidden forfait=Assemblage */}
    {variant === "assembly" && (
      <input type="hidden" name="forfait" value="Assemblage" />
    )}

    <div class="mb-4">
      <label for="name" class="block text-sm font-bold text-dark mb-1.5">{labels.name} *</label>
      <input type="text" id="name" name="name" required autocomplete="name"
        class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm" />
    </div>

    <div class="mb-4">
      <p class="text-xs text-grey mb-1.5 font-semibold">{labels.contactGroupHint} *</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="phone" class="block text-xs font-bold text-dark mb-1">{labels.phone}</label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" data-require-one="contact"
            class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm" />
        </div>
        <div>
          <label for="email" class="block text-xs font-bold text-dark mb-1">{labels.email}</label>
          <input type="email" id="email" name="email" autocomplete="email" data-require-one="contact"
            class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm" />
        </div>
      </div>
    </div>

    {/* Address — full address with Places autocomplete on service-booking variants */}
    {(variant === "cleaning" || variant === "repair" || variant === "assembly") && (
      <div class="mb-4">
        <label for="address" class="block text-sm font-bold text-dark mb-1.5">{labels.address}</label>
        <input type="text" id="address" name="address" autocomplete="street-address"
          placeholder={labels.addressPlaceholder}
          data-places-key={siteConfig.googleMapsApiKey || ""}
          data-places-lang={lang}
          class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm" />
      </div>
    )}

    {/* City or area — lighter commitment for general "I'm not sure" inquiries */}
    {variant === "general" && (
      <div class="mb-4">
        <label for="city_area" class="block text-sm font-bold text-dark mb-1.5">{labels.cityArea} <span class="text-grey font-normal">({labels.optional})</span></label>
        <input type="text" id="city_area" name="city_area"
          placeholder={labels.cityAreaPlaceholder}
          class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm" />
      </div>
    )}

    {/* BBQ brand/model — visible (optional) on all service-booking variants */}
    {(variant === "cleaning" || variant === "repair" || variant === "assembly") && (
      <div class="mb-4">
        <label for="bbq_brand" class="block text-sm font-bold text-dark mb-1.5">
          {labels.bbqBrandLabel} <span class="text-grey font-normal">({labels.optional})</span>
        </label>
        <input type="text" id="bbq_brand" name="bbq_brand"
          placeholder={labels.bbqBrandPlaceholder}
          class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm" />
      </div>
    )}

    {/* Repair variant — Problem observed (focal field) */}
    {variant === "repair" && (
      <div class="mb-4">
        <label for="symptom" class="block text-sm font-bold text-dark mb-1.5">{labels.symptom}</label>
        <textarea id="symptom" name="symptom" rows="3"
          placeholder={labels.symptomPlaceholder}
          class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm resize-y"></textarea>
      </div>
    )}

    {/* Assembly variant — Preferred date */}
    {variant === "assembly" && (
      <div class="mb-4">
        <label for="date_requested" class="block text-sm font-bold text-dark mb-1.5">
          {labels.assemblyDate} <span class="text-grey font-normal">({labels.optional})</span>
        </label>
        <input type="date" id="date_requested" name="date_requested"
          class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm" />
      </div>
    )}

    {/* Cleaning variant — Message / BBQ condition (visible per spec, no toggle) */}
    {variant === "cleaning" && (
      <div class="mb-6">
        <label for="message" class="block text-sm font-bold text-dark mb-1.5">
          {labels.cleaningMessage} <span class="text-grey font-normal">({labels.optional})</span>
        </label>
        <textarea id="message" name="message" rows="3"
          placeholder={labels.cleaningMessagePlaceholder}
          class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm resize-y"></textarea>
      </div>
    )}

    {/* Assembly variant — Message */}
    {variant === "assembly" && (
      <div class="mb-6">
        <label for="message" class="block text-sm font-bold text-dark mb-1.5">
          {labels.assemblyMessage} <span class="text-grey font-normal">({labels.optional})</span>
        </label>
        <textarea id="message" name="message" rows="3"
          placeholder={labels.assemblyMessagePlaceholder}
          class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm resize-y"></textarea>
      </div>
    )}

    {/* Repair variant — Message (optional context after the focal Symptom field) */}
    {variant === "repair" && (
      <div class="mb-6">
        <label for="message" class="block text-sm font-bold text-dark mb-1.5">
          {labels.message} <span class="text-grey font-normal">({labels.optional})</span>
        </label>
        <textarea id="message" name="message" rows="3"
          placeholder={labels.messagePlaceholder}
          class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm resize-y"></textarea>
      </div>
    )}

    {/* General variant — Message (the focal field for "I'm not sure" inquiries) */}
    {variant === "general" && (
      <div class="mb-6">
        <label for="message" class="block text-sm font-bold text-dark mb-1.5">{labels.message} *</label>
        <textarea id="message" name="message" rows="5" required
          placeholder={labels.messagePlaceholder}
          class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm resize-y"></textarea>
      </div>
    )}

    <button type="submit"
      class="w-full bg-accent text-white py-4 rounded-lg font-bold text-base hover:bg-accent-hover hover:-translate-y-0.5 transition-all cursor-pointer border-none">
      {submitLabel}
    </button>
    <p class="text-center text-xs text-grey mt-3">{labels.privacy}</p>

    {/* SMS-photo hint — present on all variants per iteration 5 spec.
        Tappable on mobile (opens SMS app), copyable on desktop. */}
    <a
      href="sms:+18195610762"
      class="block mt-4 p-3 bg-light border border-grey-mid/40 rounded-lg text-xs text-dark text-center no-underline hover:bg-accent/5 hover:border-accent transition-colors leading-relaxed"
    >
      {labels.smsPhotoHint}
    </a>
  </form>
</div>

<style is:global>
  /* Force light scheme on the Google PlaceAutocompleteElement so it doesn't
     inherit a dark background from the browser's color-scheme preference. */
  gmp-place-autocomplete {
    color-scheme: light;
    width: 100%;
    display: block;
    --gmp-mat-color-surface: #ffffff;
    --gmp-mat-color-on-surface: #111111;
    --gmp-mat-color-on-surface-variant: #333333;
    --gmp-mat-color-primary: #E81B1B;
    --gmp-mat-color-on-primary: #ffffff;
    --gmp-mat-color-outline: #d4d4d4;
    --gmp-mat-color-outline-variant: #e5e5e5;
    --gmp-mat-color-surface-container: #ffffff;
    --gmp-mat-color-surface-container-high: #f5f5f5;
    --gmp-mat-color-secondary-container: #fde8e8;
    --gmp-mat-color-on-secondary-container: #111111;
    --gmp-mat-font-family-body: 'Montserrat', sans-serif;
    --gmp-mat-font-family-headline: 'Montserrat', sans-serif;
  }
</style>

<script>
  // ───── Google Places Autocomplete (lazy-loaded on address focus) ─────
  const addressInput = document.getElementById("address") as HTMLInputElement | null;
  if (addressInput) {
    const apiKey = addressInput.dataset.placesKey || "";
    const placesLang = addressInput.dataset.placesLang || "fr";

    function initPlacesElement() {
      const g = (window as any).google;
      const PlaceAutocompleteElement = g?.maps?.places?.PlaceAutocompleteElement;
      if (!PlaceAutocompleteElement || !addressInput) return;
      try {
        const pac = new PlaceAutocompleteElement({ includedRegionCodes: ["ca"] });
        (pac as HTMLElement).style.width = "100%";
        (pac as HTMLElement).style.display = "block";
        addressInput.insertAdjacentElement("afterend", pac as HTMLElement);
        addressInput.style.display = "none";
        setTimeout(() => (pac as any).focus?.(), 0);
        pac.addEventListener("gmp-select", async (event: any) => {
          const prediction = event.placePrediction;
          if (!prediction) return;
          const place = prediction.toPlace();
          await place.fetchFields({ fields: ["formattedAddress"] });
          addressInput.value = place.formattedAddress || "";
        });
      } catch (err) {
        console.warn("[BBQTECH Places] element creation failed:", err);
      }
    }

    function loadMapsApi() {
      if (!apiKey) return;
      if ((window as any).google?.maps) {
        initPlacesElement();
        return;
      }
      const script = document.createElement("script");
      script.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(apiKey)}&libraries=places&v=weekly&language=${encodeURIComponent(placesLang)}&region=CA`;
      script.async = true;
      script.defer = true;
      script.onload = () => initPlacesElement();
      script.onerror = (e) => console.warn("[BBQTECH Places] Maps script failed to load:", e);
      document.head.appendChild(script);
    }

    addressInput.addEventListener("focus", loadMapsApi, { once: true });
  }

  // ───── Form submission ─────
  const form = document.getElementById("bbqtech-lead-form") as HTMLFormElement | null;
  const success = document.getElementById("form-status-success");
  const error = document.getElementById("form-status-error");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      success?.classList.add("hidden");
      error?.classList.add("hidden");

      // Phone OR email — at least one required
      const requireOne = Array.from(form.querySelectorAll<HTMLInputElement>('[data-require-one="contact"]'));
      const hasOne = requireOne.some((input) => input.value.trim().length > 0);
      if (!hasOne) {
        if (error) {
          error.textContent = form.dataset.errorRequireOne || "Phone or email required.";
          error.classList.remove("hidden");
          error.scrollIntoView({ behavior: "smooth", block: "center" });
        }
        return;
      }

      const submitBtn = form.querySelector("button[type=submit]") as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;

      try {
        const fd = new FormData(form);

        try {
          const attribution = JSON.parse(sessionStorage.getItem("bbqtech_attribution") || "{}");
          Object.entries(attribution).forEach(([k, v]) => fd.append(k, String(v)));
        } catch {
          /* sessionStorage unavailable or malformed — skip silently */
        }

        fd.append("page_url", window.location.href);
        fd.append("page_title", document.title);
        fd.append("user_agent", navigator.userAgent);
        fd.append("submitted_at", new Date().toISOString());

        const res = await fetch("/api/lead", { method: "POST", body: fd });
        if (res.ok) {
          // GTM dataLayer push.
          // form_variant stays "reservation"/"general" for baseline-friendly GA4 reporting.
          // form_intent captures cleaning/repair/assembly/general specifically.
          const variantValue = (fd.get("variant") as string) || "general";
          (window as any).dataLayer = (window as any).dataLayer || [];
          (window as any).dataLayer.push({
            event: "form_submission",
            form_source: (fd.get("source") as string) || "Website - Contact",
            form_variant: variantValue === "general" ? "general" : "reservation",
            form_intent: variantValue,
            form_language: (fd.get("language") as string) || "fr",
            form_forfait: (fd.get("forfait") as string) || "",
          });
          form.reset();
          success?.classList.remove("hidden");
          success?.scrollIntoView({ behavior: "smooth", block: "center" });
        } else {
          if (error) {
            error.textContent = form.dataset.errorDefault || "Something went wrong.";
            error.classList.remove("hidden");
          }
        }
      } catch {
        if (error) {
          error.textContent = form.dataset.errorDefault || "Something went wrong.";
          error.classList.remove("hidden");
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>
