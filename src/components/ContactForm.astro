---
import { siteConfig } from "../../site.config";
import { type Locale, t } from "../i18n/utils";

interface Props {
  lang: Locale;
  source?: string;
}

const { lang, source = "Website - Contact Page" } = Astro.props;

const isFr = lang === "fr";

const labels = isFr
  ? {
      name: "Nom complet",
      phone: "Téléphone",
      email: "Courriel",
      address: "Adresse",
      addressPlaceholder: "123 rue Principale, Gatineau QC J8X 1A1",
      service: "Service demandé",
      servicePlaceholder: "Recommandez-moi",
      message: "Détails",
      messagePlaceholder: "Marque/modèle, taille, état du BBQ, particularités…",
      submit: "Envoyer ma demande",
      privacy: "Réponse confirmée sous 24 h. Aucun pourriel.",
      sentSuccess: "Merci, votre demande a été reçue. On vous répond sous 24 h.",
      sentError: "Une erreur est survenue. Appelez 819-561-0762 ou réessayez.",
    }
  : {
      name: "Full name",
      phone: "Phone",
      email: "Email",
      address: "Address",
      addressPlaceholder: "123 Main St, Gatineau QC J8X 1A1",
      service: "Service needed",
      servicePlaceholder: "Recommend me",
      message: "Details",
      messagePlaceholder: "Brand/model, size, BBQ condition, specifics…",
      submit: "Send my request",
      privacy: "Confirmed reply within 24 h. No spam, ever.",
      sentSuccess: "Thanks, your request was received. We'll reply within 24 h.",
      sentError: "Something went wrong. Call 819-561-0762 or try again.",
    };

const serviceOptions = isFr
  ? [
      { v: "Nettoyage", l: "Nettoyage BBQ à domicile — dès 195 $" },
      { v: "Assemblage", l: "Assemblage BBQ — dès 149 $" },
      { v: "Diagnostic", l: "Diagnostic & réparation — 125 $" },
      { v: "Nettoyage + Réparation", l: "Combo nettoyage + diagnostic" },
      { v: "Commercial", l: "Entretien commercial / multi-unités" },
      { v: "Soumission", l: "Soumission personnalisée" },
      { v: "Information", l: "Information générale" },
    ]
  : [
      { v: "Cleaning", l: "On-site BBQ Cleaning — from $195" },
      { v: "Assembly", l: "BBQ Assembly — from $149" },
      { v: "Diagnostic", l: "Diagnostic & Repair — $125" },
      { v: "Cleaning + Repair", l: "Combo cleaning + diagnostic" },
      { v: "Commercial", l: "Commercial / Multi-unit maintenance" },
      { v: "Quote", l: "Custom quote" },
      { v: "Information", l: "General inquiry" },
    ];
---

<section class="py-12 md:py-16 bg-light" id="contact-form">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="max-w-[640px] mx-auto">
      <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-3">{t(siteConfig.contact.formHeading, lang)}</h2>
      <p class="text-center text-grey mb-8">{t(siteConfig.contact.formSub, lang)}</p>

      <div id="form-status-success" class="hidden mb-6 p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm">
        {labels.sentSuccess}
      </div>
      <div id="form-status-error" class="hidden mb-6 p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm">
        {labels.sentError}
      </div>

      <form
        method="POST"
        action="/api/lead"
        accept-charset="UTF-8"
        class="bg-white rounded-xl p-6 md:p-8 shadow-sm border border-grey-mid/40"
        data-lead-form
        id="bbqtech-lead-form"
      >
        <input type="hidden" name="source" value={source} />
        <input type="hidden" name="language" value={lang} />

        <div class="mb-4">
          <label for="name" class="block text-sm font-bold text-dark mb-1.5">{labels.name} *</label>
          <input type="text" id="name" name="name" required autocomplete="name"
            class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div>
            <label for="phone" class="block text-sm font-bold text-dark mb-1.5">{labels.phone} *</label>
            <input type="tel" id="phone" name="phone" required autocomplete="tel"
              class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm" />
          </div>
          <div>
            <label for="email" class="block text-sm font-bold text-dark mb-1.5">{labels.email} *</label>
            <input type="email" id="email" name="email" required autocomplete="email"
              class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm" />
          </div>
        </div>

        <div class="mb-4">
          <label for="address" class="block text-sm font-bold text-dark mb-1.5">{labels.address}</label>
          <input type="text" id="address" name="address" autocomplete="street-address"
            placeholder={labels.addressPlaceholder}
            data-places-key={siteConfig.googleMapsApiKey || ""}
            data-places-lang={lang}
            class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm" />
        </div>

        <div class="mb-4">
          <label for="service" class="block text-sm font-bold text-dark mb-1.5">{labels.service}</label>
          <select id="service" name="service"
            class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm">
            <option value="">{labels.servicePlaceholder}</option>
            {serviceOptions.map((o) => <option value={o.v}>{o.l}</option>)}
          </select>
        </div>

        <div class="mb-6">
          <label for="message" class="block text-sm font-bold text-dark mb-1.5">{labels.message}</label>
          <textarea id="message" name="message" rows="4"
            placeholder={labels.messagePlaceholder}
            class="w-full px-4 py-3 border border-grey-mid rounded-lg bg-white text-dark text-sm resize-y"></textarea>
        </div>

        <button type="submit"
          class="w-full bg-accent text-white py-4 rounded-lg font-bold text-base hover:bg-accent-hover hover:-translate-y-0.5 transition-all cursor-pointer border-none">
          {labels.submit}
        </button>
        <p class="text-center text-xs text-grey mt-3">{labels.privacy}</p>
      </form>
    </div>
  </div>
</section>

<script>
  // ───── Google Places Autocomplete (lazy-loaded on address focus) ─────
  // Only activates if siteConfig.googleMapsApiKey is set. Otherwise the
  // input keeps native HTML5 autofill (autocomplete="street-address").
  const addressInput = document.getElementById("address") as HTMLInputElement | null;
  if (addressInput) {
    const apiKey = addressInput.dataset.placesKey || "";
    const placesLang = addressInput.dataset.placesLang || "fr";
    if (apiKey) {
      let placesLoaded = false;
      addressInput.addEventListener(
        "focus",
        () => {
          if (placesLoaded) return;
          placesLoaded = true;
          (window as any).__bbqtechInitPlaces = function () {
            const g = (window as any).google;
            if (!g?.maps?.places?.Autocomplete) return;
            const ac = new g.maps.places.Autocomplete(addressInput, {
              componentRestrictions: { country: ["ca"] },
              fields: ["formatted_address"],
              types: ["address"],
            });
            ac.addListener("place_changed", () => {
              const place = ac.getPlace();
              if (place?.formatted_address) {
                addressInput.value = place.formatted_address;
                addressInput.dispatchEvent(new Event("input", { bubbles: true }));
              }
            });
          };
          const script = document.createElement("script");
          script.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(apiKey)}&libraries=places&language=${encodeURIComponent(placesLang)}&region=CA&loading=async&callback=__bbqtechInitPlaces`;
          script.async = true;
          script.defer = true;
          document.head.appendChild(script);
        },
        { once: true }
      );
    }
  }

  // ───── Form submission ─────
  const form = document.getElementById("bbqtech-lead-form") as HTMLFormElement | null;
  const success = document.getElementById("form-status-success");
  const error = document.getElementById("form-status-error");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      success?.classList.add("hidden");
      error?.classList.add("hidden");

      const submitBtn = form.querySelector("button[type=submit]") as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;

      try {
        const fd = new FormData(form);

        // Inject first-touch attribution captured in Base.astro
        try {
          const attribution = JSON.parse(sessionStorage.getItem("bbqtech_attribution") || "{}");
          Object.entries(attribution).forEach(([k, v]) => fd.append(k, String(v)));
        } catch {
          /* sessionStorage unavailable or malformed — skip silently */
        }

        // Last-touch context captured at submit time
        fd.append("page_url", window.location.href);
        fd.append("page_title", document.title);
        fd.append("user_agent", navigator.userAgent);
        fd.append("submitted_at", new Date().toISOString());

        const res = await fetch("/api/lead", { method: "POST", body: fd });
        if (res.ok) {
          form.reset();
          success?.classList.remove("hidden");
          success?.scrollIntoView({ behavior: "smooth", block: "center" });
        } else {
          error?.classList.remove("hidden");
        }
      } catch {
        error?.classList.remove("hidden");
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>
