---
import { siteConfig } from "../../site.config";
import { type Locale, t, localeHref, bookingHref } from "../i18n/utils";

interface Props {
  lang: Locale;
  title: string;
  subtitle?: string;
}

const { lang, title, subtitle } = Astro.props;
const booking = bookingHref(siteConfig.bookingUrl, lang);
const secondaryHref = localeHref(siteConfig.cta.secondary.hrefPath, lang);
const orCallLabel = lang === "fr" ? "ou appelez" : "or call";
---

<section class="bg-black py-16 md:py-20 text-white text-center relative overflow-hidden">
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-accent/10 blur-[140px] -z-10"></div>
  <div class="max-w-[1200px] mx-auto px-6 relative">
    <h2 class="text-3xl md:text-4xl font-extrabold mb-4">{title}</h2>
    {subtitle && <p class="text-lg text-white/75 mb-8 max-w-2xl mx-auto">{subtitle}</p>}
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4">
      <a
        href={booking.href}
        target={booking.external ? "_blank" : undefined}
        rel={booking.external ? "noopener noreferrer" : undefined}
        class="inline-block text-center bg-accent text-white px-10 py-4 rounded-lg text-base font-bold hover:bg-accent-hover hover:-translate-y-0.5 transition-all no-underline shadow-lg shadow-accent/20"
      >
        {t(siteConfig.cta.primary.label, lang)}
      </a>
      <a
        href={secondaryHref}
        class="inline-block text-center text-white border-2 border-white/30 px-10 py-4 rounded-lg text-base font-bold hover:border-white hover:bg-white/5 transition-all no-underline"
      >
        {t(siteConfig.cta.secondary.label, lang)}
      </a>
    </div>
    <p class="mt-6 text-sm text-white/50">
      {orCallLabel} <a href={`tel:${siteConfig.phoneRaw}`} class="text-accent font-bold no-underline">{siteConfig.phone}</a>
    </p>
  </div>
</section>
