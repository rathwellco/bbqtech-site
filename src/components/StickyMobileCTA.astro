---
import { siteConfig } from "../../site.config";
import { type Locale, bookingHref } from "../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const booking = bookingHref(siteConfig.bookingUrl, lang);
const callLabel = lang === "fr" ? "Appeler" : "Call";
const bookLabel = lang === "fr" ? "Réserver" : "Book";
---

<div class="fixed bottom-0 left-0 right-0 z-40 grid grid-cols-2 md:hidden border-t border-black">
  <a
    href={`tel:${siteConfig.phoneRaw}`}
    class="bg-black text-white text-center py-4 font-bold text-sm no-underline flex items-center justify-center gap-2"
  >
    📞 {callLabel}
  </a>
  <a
    href={booking.href}
    target={booking.external ? "_blank" : undefined}
    rel={booking.external ? "noopener noreferrer" : undefined}
    class="bg-accent text-white text-center py-4 font-bold text-sm no-underline flex items-center justify-center gap-2"
  >
    📅 {bookLabel}
  </a>
</div>
