---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import ServiceCard from "../components/ServiceCard.astro";
import PricingTable from "../components/PricingTable.astro";
import QuelForfait from "../components/QuelForfait.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import WhyBBQTECH from "../components/WhyBBQTECH.astro";
import OwnerOperator from "../components/OwnerOperator.astro";
import CustomQuote from "../components/CustomQuote.astro";
import RepairDiagnostic from "../components/RepairDiagnostic.astro";
import EquipmentTypes from "../components/EquipmentTypes.astro";
import Brands from "../components/Brands.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import Philosophy from "../components/Philosophy.astro";
import Commitments from "../components/Commitments.astro";
import FAQ from "../components/FAQ.astro";
import CTABanner from "../components/CTABanner.astro";
import { siteConfig } from "../../site.config";
import { t, localeHref } from "../i18n/utils";

const lang = "fr" as const;
const homeTitle = t(siteConfig.seo.homeTitle, lang);
---

<Base lang={lang} title="Accueil" description={t(siteConfig.seo.defaultDescription, lang)}>
  <Hero
    lang={lang}
    title={t(siteConfig.hero.h1, lang)}
    subtitle={t(siteConfig.hero.sub, lang)}
    support={t(siteConfig.hero.support, lang)}
  />

  <TrustBar lang={lang} />

  <BeforeAfter lang={lang} />

  <!-- Services -->
  <section class="py-16 md:py-20 bg-white" id="services">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="text-center mb-12 md:mb-14">
        <h2 class="text-3xl md:text-4xl font-extrabold mb-4">Nettoyage, assemblage et réparation BBQ</h2>
        <p class="text-lg text-grey max-w-2xl mx-auto">Service mobile à domicile à Gatineau et Ottawa. Nettoyage BBQ, assemblage, diagnostic / réparation et entretien commercial.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {siteConfig.services.map((s) => (
          <ServiceCard
            icon={s.icon}
            title={t(s.name, lang)}
            price={t(s.priceLabel, lang)}
            description={t(s.summary, lang)}
            ctaLabel="Demander une soumission"
            ctaHref={localeHref("/contact", lang)}
          />
        ))}
      </div>
    </div>
  </section>

  <EquipmentTypes lang={lang} />

  <PricingTable
    lang={lang}
    title="Trois forfaits de nettoyage BBQ"
    subtitle="Choisissez le niveau adapté à votre BBQ : préparer la saison, nettoyage annuel plus approfondi, ou remise en état avancée à la vapeur."
  />

  <QuelForfait lang={lang} />

  <OwnerOperator lang={lang} />

  <CustomQuote lang={lang} />

  <RepairDiagnostic lang={lang} />

  <WhyBBQTECH
    lang={lang}
    title="Pourquoi choisir BBQTECH ?"
    subtitle="Une approche spécialisée pour l'entretien de votre BBQ — service mobile, forfaits clairs et méthodes adaptées."
  />

  <ProcessSteps lang={lang} title="Comment ça marche" />

  <Philosophy lang={lang} />

  <Commitments lang={lang} title="Notre engagement" />

  <Brands lang={lang} />

  <FAQ lang={lang} title="Questions fréquentes" />

  <CTABanner
    lang={lang}
    title="Réservez votre nettoyage ou votre appel de service."
    subtitle="Envoyez-nous une photo. On vous recommande le bon forfait et on confirme les détails du rendez-vous. Si un ajustement est nécessaire sur place, on vous informe avant tout changement."
  />
</Base>
