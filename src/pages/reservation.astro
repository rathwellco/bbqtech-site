---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";

const lang = "fr" as const;

const intentCards = [
  {
    href: "/reservation-nettoyage",
    icon: "🧽",
    title: "Nettoyage BBQ",
    desc: "Entretien saisonnier, nettoyage approfondi ou remise en état de votre BBQ.",
    cta: "Choisir un forfait de nettoyage",
  },
  {
    href: "/reservation-reparation",
    icon: "🔧",
    title: "Réparation / Diagnostic",
    desc: "Problème d'allumage, flamme faible, brûleur endommagé, régulateur, pièces usées ou BBQ qui ne fonctionne pas correctement.",
    cta: "Réserver un diagnostic",
  },
  {
    href: "/reservation-assemblage",
    icon: "🔩",
    title: "Assemblage BBQ",
    desc: "Assemblage d'un nouveau BBQ, fumoir, gril ou équipement de cuisson extérieure.",
    cta: "Demander un assemblage",
  },
  {
    href: "/contact",
    icon: "💬",
    title: "Je ne suis pas certain",
    desc: "Envoyez-nous quelques détails ou une photo, et nous vous recommanderons le bon service.",
    cta: "Demander une recommandation",
  },
];
---

<Base
  lang={lang}
  title="Réserver un service BBQ"
  description="De quel service avez-vous besoin? Nettoyage, diagnostic, assemblage ou recommandation. Réservez en 2 minutes. Réponse en 24 h."
>
  <Hero
    lang={lang}
    title="De quel service avez-vous besoin ?"
    subtitle="Choisissez l'option qui correspond le mieux à votre besoin. Réponse en 24 h."
    short={true}
    showCtas={false}
    showHeroImage={false}
  />

  <section class="py-10 md:py-14 bg-light">
    <div class="max-w-[1100px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
        {intentCards.map((card) => (
          <a
            href={card.href}
            class="block bg-white rounded-xl p-5 md:p-6 border-2 border-grey-mid/40 hover:border-accent hover:shadow-lg hover:-translate-y-0.5 transition-all no-underline group"
          >
            <div class="text-3xl mb-3">{card.icon}</div>
            <h3 class="text-lg md:text-xl font-extrabold text-dark mb-2 group-hover:text-accent transition-colors">{card.title}</h3>
            <p class="text-sm text-grey mb-4 leading-relaxed">{card.desc}</p>
            <span class="inline-block text-sm font-bold text-accent">{card.cta} →</span>
          </a>
        ))}
      </div>

      <p class="text-center text-sm text-grey mt-10">
        Vous préférez le téléphone ?
        <a href="tel:+18195610762" class="text-accent font-bold no-underline hover:underline">📞 819-561-0762</a>
      </p>
    </div>
  </section>
</Base>
