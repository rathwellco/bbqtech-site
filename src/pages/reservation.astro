---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ContactForm from "../components/ContactForm.astro";

const lang = "fr" as const;
const defaultForfait = Astro.url.searchParams.get("forfait") ?? undefined;
---

<Base
  lang={lang}
  title="Réserver un service BBQ"
  description="Réservez un service BBQTECH à Gatineau ou Ottawa. Nettoyage, diagnostic, assemblage, restauration. Réponse en 24 h."
>
  <Hero
    lang={lang}
    title="Réserver un service BBQ"
    subtitle="Mobile · Gatineau et Ottawa · Réponse en 24 h"
    short={true}
    showCtas={false}
    showHeroImage={false}
  />

  <section class="py-8 md:py-12 bg-light">
    <div class="max-w-[1200px] mx-auto px-6">
      <ContactForm lang={lang} variant="reservation" defaultForfait={defaultForfait} />
    </div>
  </section>
</Base>
