---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import TrustBar from "../../components/TrustBar.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import PricingTable from "../../components/PricingTable.astro";
import QuelForfait from "../../components/QuelForfait.astro";
import BeforeAfter from "../../components/BeforeAfter.astro";
import WhyBBQTECH from "../../components/WhyBBQTECH.astro";
import OwnerOperator from "../../components/OwnerOperator.astro";
import CustomQuote from "../../components/CustomQuote.astro";
import RepairDiagnostic from "../../components/RepairDiagnostic.astro";
import EquipmentTypes from "../../components/EquipmentTypes.astro";
import Brands from "../../components/Brands.astro";
import ProcessSteps from "../../components/ProcessSteps.astro";
import Philosophy from "../../components/Philosophy.astro";
import Commitments from "../../components/Commitments.astro";
import FAQ from "../../components/FAQ.astro";
import CTABanner from "../../components/CTABanner.astro";
import { siteConfig } from "../../../site.config";
import { t, localeHref } from "../../i18n/utils";

const lang = "en" as const;
---

<Base lang={lang} title="Home" description={t(siteConfig.seo.defaultDescription, lang)}>
  <Hero
    lang={lang}
    title={t(siteConfig.hero.h1, lang)}
    subtitle={t(siteConfig.hero.sub, lang)}
    support={t(siteConfig.hero.support, lang)}
  />

  <TrustBar lang={lang} />

  <BeforeAfter lang={lang} />

  <section class="py-16 md:py-20 bg-white" id="services">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="text-center mb-12 md:mb-14">
        <h2 class="text-3xl md:text-4xl font-extrabold mb-4">BBQ cleaning, assembly and repair</h2>
        <p class="text-lg text-grey max-w-2xl mx-auto">Mobile on-site service in Gatineau and Ottawa. BBQ cleaning, assembly, diagnostic / repair, and commercial maintenance.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {siteConfig.services.map((s) => (
          <ServiceCard
            icon={s.icon}
            title={t(s.name, lang)}
            price={t(s.priceLabel, lang)}
            description={t(s.summary, lang)}
            ctaLabel="Request a quote"
            ctaHref={localeHref("/contact", lang)}
          />
        ))}
      </div>
    </div>
  </section>

  <EquipmentTypes lang={lang} />

  <PricingTable
    lang={lang}
    title="Three BBQ cleaning packages"
    subtitle="Pick the level that fits your BBQ: season prep, more thorough annual cleaning, or advanced restoration with multiple passes and steam as needed."
  />

  <QuelForfait lang={lang} />

  <OwnerOperator lang={lang} />

  <CustomQuote lang={lang} />

  <RepairDiagnostic lang={lang} />

  <WhyBBQTECH
    lang={lang}
    title="Why choose BBQTECH?"
    subtitle="A specialized approach for your BBQ — mobile service, clear packages, and methods adapted to your equipment."
  />

  <ProcessSteps lang={lang} title="How it works" />

  <Philosophy lang={lang} />

  <Commitments lang={lang} title="Our commitments" />

  <Brands lang={lang} />

  <FAQ lang={lang} title="Frequently asked questions" />

  <CTABanner
    lang={lang}
    title="Book your cleaning or service call."
    subtitle="Send us a photo. We'll recommend the right package and confirm the appointment details. If an adjustment is needed on site, we tell you before any change."
  />
</Base>
