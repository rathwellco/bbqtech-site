---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import ContactForm from "../../components/ContactForm.astro";
import { siteConfig } from "../../../site.config";

const lang = "en" as const;
---

<Base
  lang={lang}
  title="BBQ diagnostic & repair"
  description="On-site assessment to identify a BBQ issue. $99 + taxes. Parts and labour billed separately if you approve the repair. Gatineau and Ottawa."
>
  <Hero
    lang={lang}
    title="BBQ diagnostic & repair"
    subtitle="On-site assessment to identify the issue: ignition, weak flame, faulty burner, uneven heat. Confirmed reply within 24 h."
    short={true}
    showCtas={false}
    showHeroImage={false}
  />

  <section class="py-10 md:py-14 bg-light">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="max-w-[640px] mx-auto mb-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-1 text-xs md:text-sm text-grey">
        <a href={`tel:${siteConfig.phoneRaw}`} class="text-dark font-bold no-underline hover:text-accent">📞 {siteConfig.phone}</a>
        <span class="hidden sm:inline">·</span>
        <span>Reply within 24 h</span>
        <span class="hidden sm:inline">·</span>
        <span>Gatineau · Ottawa</span>
      </div>
      <ContactForm lang={lang} variant="diagnostic" />
    </div>
  </section>
</Base>
