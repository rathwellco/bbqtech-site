---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import ContactForm from "../../components/ContactForm.astro";
import { siteConfig } from "../../../site.config";
import { t } from "../../i18n/utils";

const lang = "en" as const;

const intentCards = [
  {
    href: "/en/booking-cleaning",
    icon: "🧽",
    title: "Book a cleaning",
    desc: "Maintenance, Cleaning or Restoration",
    price: "from $199 + tx",
  },
  {
    href: "/en/booking-repair",
    icon: "🔧",
    title: "Diagnostic / repair",
    desc: "On-site assessment for a BBQ that's not working",
    price: "$99 + tx",
  },
  {
    href: "#general-form",
    icon: "💬",
    title: "Other request",
    desc: "Assembly, commercial, quote or general question",
    price: "Reply within 24 h",
  },
];
---

<Base
  lang={lang}
  title="Contact"
  description="Choose the type of request: book a package, repair diagnostic, or general question. Confirmed reply within 24 h. Call 819-561-0762."
>
  <Hero
    lang={lang}
    title="How can we help?"
    subtitle="Choose the type of request that fits your need. Confirmed reply within 24 h. For faster service, call directly at 819-561-0762."
    short={true}
    showCtas={false}
    showHeroImage={false}
  />

  <section class="py-10 md:py-14 bg-light">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5 mb-12 md:mb-16">
        {intentCards.map((card) => (
          <a
            href={card.href}
            class="block bg-white rounded-xl p-5 md:p-6 border-2 border-grey-mid/40 hover:border-accent hover:shadow-lg hover:-translate-y-0.5 transition-all no-underline group"
          >
            <div class="text-3xl mb-3">{card.icon}</div>
            <h3 class="text-lg md:text-xl font-extrabold text-dark mb-1.5 group-hover:text-accent transition-colors">{card.title}</h3>
            <p class="text-sm text-grey mb-3 leading-relaxed">{card.desc}</p>
            <span class="text-xs font-bold text-accent">{card.price} →</span>
          </a>
        ))}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-10 lg:gap-14">
        <div>
          <div id="general-form" class="scroll-mt-24">
            <h2 class="text-2xl md:text-3xl font-extrabold text-dark mb-2 text-center">Other request</h2>
            <p class="text-center text-sm text-grey mb-6">Assembly, commercial, multi-unit or any other question that doesn't match the two options above.</p>
            <ContactForm lang={lang} variant="general" />
          </div>
        </div>

        <aside class="space-y-6 lg:pt-4">
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-grey mb-1.5">Phone</h3>
            <a href={`tel:${siteConfig.phoneRaw}`} class="text-xl text-accent font-extrabold no-underline hover:underline">
              📞 {siteConfig.phone}
            </a>
          </div>
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-grey mb-1.5">Email</h3>
            <a href={`mailto:${siteConfig.email}`} class="text-sm text-dark font-semibold no-underline hover:text-accent break-all">
              {siteConfig.email}
            </a>
          </div>
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-grey mb-1.5">Service area</h3>
            <p class="text-sm text-dark">Gatineau · Ottawa</p>
            <p class="text-xs text-grey mt-0.5">Aylmer · Hull · Plateau · Buckingham · Ottawa</p>
          </div>
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-grey mb-1.5">Hours</h3>
            <p class="text-sm text-dark">{t(siteConfig.contact.hours, lang)}</p>
            <p class="text-xs text-grey mt-0.5">{t(siteConfig.contact.season, lang)}</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>
