---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import ContactForm from "../../components/ContactForm.astro";

const lang = "en" as const;
const defaultForfait = Astro.url.searchParams.get("forfait") ?? undefined;
---

<Base
  lang={lang}
  title="Book a BBQ service"
  description="Book a BBQTECH service in Gatineau or Ottawa. Cleaning, diagnostic, assembly, restoration. Reply within 24 h."
>
  <Hero
    lang={lang}
    title="Book a BBQ service"
    subtitle="Mobile · Gatineau and Ottawa · Reply within 24 h"
    short={true}
    showCtas={false}
    showHeroImage={false}
  />

  <section class="py-8 md:py-12 bg-light">
    <div class="max-w-[1200px] mx-auto px-6">
      <ContactForm lang={lang} variant="reservation" defaultForfait={defaultForfait} />
    </div>
  </section>
</Base>
