---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ContactForm from "../components/ContactForm.astro";
import { siteConfig } from "../../site.config";
import { t } from "../i18n/utils";

const lang = "fr" as const;

const intentCards = [
  {
    href: "/reservation",
    icon: "🧽",
    title: "Réserver un service",
    desc: "Entretien, Nettoyage, Restauration, Assemblage ou Diagnostic / réparation",
    price: "à partir de 99 $ + tx",
  },
  {
    href: "#general-form",
    icon: "💬",
    title: "Question générale",
    desc: "Commercial, multi-unités, soumission ou toute autre question",
    price: "Réponse sous 24 h",
  },
];
---

<Base
  lang={lang}
  title="Contact"
  description="Choisissez le type de demande : réservation de forfait, diagnostic réparation ou question générale. Réponse confirmée sous 24 h. Téléphone 819-561-0762."
>
  <Hero
    lang={lang}
    title="Comment pouvons-nous vous aider ?"
    subtitle="Choisissez le type de demande qui correspond à votre besoin. Réponse confirmée sous 24 h. Pour un service plus rapide, appelez directement au 819-561-0762."
    short={true}
    showCtas={false}
    showHeroImage={false}
  />

  <section class="py-10 md:py-14 bg-light">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-12 md:mb-16 max-w-[920px] mx-auto">
        {intentCards.map((card) => (
          <a
            href={card.href}
            class="block bg-white rounded-xl p-5 md:p-6 border-2 border-grey-mid/40 hover:border-accent hover:shadow-lg hover:-translate-y-0.5 transition-all no-underline group"
          >
            <div class="text-3xl mb-3">{card.icon}</div>
            <h3 class="text-lg md:text-xl font-extrabold text-dark mb-1.5 group-hover:text-accent transition-colors">{card.title}</h3>
            <p class="text-sm text-grey mb-3 leading-relaxed">{card.desc}</p>
            <span class="text-xs font-bold text-accent">{card.price} →</span>
          </a>
        ))}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-10 lg:gap-14">
        <div>
          <div id="general-form" class="scroll-mt-24">
            <h2 class="text-2xl md:text-3xl font-extrabold text-dark mb-2 text-center">Posez votre question</h2>
            <p class="text-center text-sm text-grey mb-6">Pour toute demande qui n'est pas une réservation de service.</p>
            <ContactForm lang={lang} variant="general" />
          </div>
        </div>

        <aside class="space-y-6 lg:pt-4">
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-grey mb-1.5">Téléphone</h3>
            <a href={`tel:${siteConfig.phoneRaw}`} class="text-xl text-accent font-extrabold no-underline hover:underline">
              📞 {siteConfig.phone}
            </a>
          </div>
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-grey mb-1.5">Courriel</h3>
            <a href={`mailto:${siteConfig.email}`} class="text-sm text-dark font-semibold no-underline hover:text-accent break-all">
              {siteConfig.email}
            </a>
          </div>
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-grey mb-1.5">Zone desservie</h3>
            <p class="text-sm text-dark">Gatineau · Ottawa</p>
            <p class="text-xs text-grey mt-0.5">Aylmer · Hull · Plateau · Buckingham · Ottawa</p>
          </div>
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-grey mb-1.5">Horaire</h3>
            <p class="text-sm text-dark">{t(siteConfig.contact.hours, lang)}</p>
            <p class="text-xs text-grey mt-0.5">{t(siteConfig.contact.season, lang)}</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>
