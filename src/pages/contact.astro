---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ContactForm from "../components/ContactForm.astro";
import { siteConfig } from "../../site.config";
import { t } from "../i18n/utils";

const lang = "fr" as const;
---

<Base
  lang={lang}
  title="Demander une recommandation"
  description="Pas certain du service dont vous avez besoin ? Envoyez-nous quelques détails et nous vous recommanderons la meilleure approche. Réponse en 24 h."
>
  <Hero
    lang={lang}
    title="Demander une recommandation"
    subtitle="Pas certain du service dont vous avez besoin ? Envoyez-nous quelques détails et nous vous recommanderons la meilleure approche."
    short={true}
    showCtas={false}
    showHeroImage={false}
  />

  <section class="py-10 md:py-14 bg-light">
    <div class="max-w-[1200px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-10 lg:gap-14">
      <div>
        <ContactForm lang={lang} variant="general" />
      </div>

      <aside class="space-y-6 lg:pt-4">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-grey mb-1.5">Téléphone</h3>
          <a href={`tel:${siteConfig.phoneRaw}`} class="text-xl text-accent font-extrabold no-underline hover:underline">
            📞 {siteConfig.phone}
          </a>
        </div>
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-grey mb-1.5">Courriel</h3>
          <a href={`mailto:${siteConfig.email}`} class="text-sm text-dark font-semibold no-underline hover:text-accent break-all">
            {siteConfig.email}
          </a>
        </div>
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-grey mb-1.5">Zone desservie</h3>
          <p class="text-sm text-dark">Gatineau · Ottawa</p>
          <p class="text-xs text-grey mt-0.5">Aylmer · Hull · Plateau · Buckingham · Ottawa</p>
        </div>
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-grey mb-1.5">Horaire</h3>
          <p class="text-sm text-dark">{t(siteConfig.contact.hours, lang)}</p>
          <p class="text-xs text-grey mt-0.5">{t(siteConfig.contact.season, lang)}</p>
        </div>
        <div class="pt-2 border-t border-grey-mid/30">
          <h3 class="text-xs font-bold uppercase tracking-wider text-grey mb-2">Vous savez déjà ce qu'il vous faut ?</h3>
          <a href="/reservation" class="text-sm text-accent font-bold no-underline hover:underline">→ Choisir un service</a>
        </div>
      </aside>
    </div>
  </section>
</Base>
