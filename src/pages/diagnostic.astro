---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ContactForm from "../components/ContactForm.astro";
import { siteConfig } from "../../site.config";

const lang = "fr" as const;
---

<Base
  lang={lang}
  title="Diagnostic & réparation BBQ"
  description="Évaluation à domicile pour identifier la cause d'un problème de BBQ. 99 $ + taxes. Pièces et main-d'œuvre facturées séparément si vous approuvez la réparation. Gatineau et Ottawa."
>
  <Hero
    lang={lang}
    title="Diagnostic & réparation de BBQ"
    subtitle="Évaluation à domicile pour identifier la cause du problème : allumage, flamme faible, brûleur défectueux, chaleur inégale. Réponse confirmée sous 24 h."
    short={true}
    showCtas={false}
    showHeroImage={false}
  />

  <section class="py-10 md:py-14 bg-light">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="max-w-[640px] mx-auto mb-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-1 text-xs md:text-sm text-grey">
        <a href={`tel:${siteConfig.phoneRaw}`} class="text-dark font-bold no-underline hover:text-accent">📞 {siteConfig.phone}</a>
        <span class="hidden sm:inline">·</span>
        <span>Réponse sous 24 h</span>
        <span class="hidden sm:inline">·</span>
        <span>Gatineau · Ottawa</span>
      </div>
      <ContactForm lang={lang} variant="diagnostic" />
    </div>
  </section>
</Base>
